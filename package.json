{
  "name": "raise-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/dev.mjs",
    "start": "node --env-file-if-exists=.env.local server/start.mjs",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "audit:known": "node scripts/check-audit.mjs",
    "release:files": "node scripts/check-release.mjs",
    "check": "npm test -- --reporter=verbose && npm run build && npm run audit:known",
    "release:check": "npm run release:files && npm run check"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@perxona/presenter-types": "0.3.0",
    "express": "5.2.1",
    "opencc-js": "1.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
